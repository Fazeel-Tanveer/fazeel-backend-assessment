# Copy to .env and fill in every value. The README lists the values for the local Docker services.
NODE_ENV=
PORT=
# comma-separated browser origins allowed to call the API
CORS_ORIGINS=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

REDIS_URL=

RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_URL=

# at least 32 characters each, generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
OTP_SECRET=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# optional, defaults are in the README
# DATABASE_POOL_SIZE=
# JWT_ACCESS_TTL_SECONDS=
# REFRESH_TOKEN_TTL_DAYS=
# BCRYPT_ROUNDS=
# THROTTLE_TTL_MS=
# THROTTLE_LIMIT=
# print email/SMS messages, login codes included, to the worker log even in production (docker compose defaults it to true)
# LOG_NOTIFICATION_CONTENT=
